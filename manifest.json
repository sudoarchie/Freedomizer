{
  "manifest_version": 3,
  "name": "Scroll UX Disruptor",
  "version": "1.2",
  "description": "Blocks downward scrolling and disrupts UX on user-specified websites.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
